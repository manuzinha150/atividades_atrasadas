// 1. Atividade - Produto

class Produto {
  String nome;
  double preco;
  int quantidade;

  Produto(this.nome, this.preco, this.quantidade);

  void mostrarDados() {
    print('Produto: $nome');
    print('Preço: R\$ $preco');
    print('Quantidade: $quantidade');
  }

  void calcularTotal() {
    double total = preco * quantidade;
    print('Total em estoque: R\$ $total');
    print('-------------------');
  }
}

void main() {
  Produto p1 = Produto('Caderno', 15.0, 10);
  Produto p2 = Produto('Caneta', 3.0, 20);
  Produto p3 = Produto('Mochila', 80.0, 5);

  p1.mostrarDados();
  p1.calcularTotal();

  p2.mostrarDados();
  p2.calcularTotal();

  p3.mostrarDados();
  p3.calcularTotal();
}



