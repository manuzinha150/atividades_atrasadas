void main() {
  // Criando a fila (FIFO)
  List<String> fila = [];

  // Adicionando clientes
  fila.addAll(["Manuela", "Layza", "Adicia"]);

  print("Fila inicial: $fila");

  // Atendendo o primeiro cliente
  String atendido = fila.removeAt(0);
  print("Cliente atendido: $atendido");

  // Mostrando a fila após atendimento
  print("Fila atual: $fila");

  // Exibindo tamanho da fila
  print("Quantidade de clientes restantes: ${fila.length}");
}
